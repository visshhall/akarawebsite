# Copy this file's structure into Railway's environment variables (Railway
# dashboard -> your service -> Variables tab). Never commit a real .env
# file with actual values — .gitignore already excludes .env and .env.local.

# Razorpay Key ID is safe to expose (it's meant to run in the browser).
# The Key Secret is NOT — it must only ever exist in Railway's environment
# variables, never in this file, never in code, never pasted in chat.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=set-this-directly-in-railway-only

# The webhook secret is configured separately, in the Razorpay Dashboard
# under Settings -> Webhooks, when you set the webhook URL to
# https://your-domain/webhooks/razorpay. Razorpay shows you this secret
# once, at that point — same rule as the Key Secret: Railway only, never
# committed here, never pasted in chat.
RAZORPAY_WEBHOOK_SECRET=set-this-directly-in-railway-only

# Set automatically by Railway once Postgres is added to the project and
# referenced from this service (Variables tab -> add DATABASE_URL -> value
# ${{Postgres.DATABASE_PRIVATE_URL}}). Locally, point this at your own
# Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/akara_dev

# Any long random string — used to sign login session tokens. Generate one
# with: openssl rand -hex 32
# Set this directly in Railway's Variables tab, never commit the real value.
JWT_SECRET=set-this-directly-in-railway-only

# Any long random string, DIFFERENT from JWT_SECRET — used for CSRF
# protection (see server/csrf.js). Generate the same way: openssl rand -hex 32
# Same rule: Railway's Variables tab only, never committed here.
CSRF_SECRET=set-this-directly-in-railway-only

# Admin panel session signing secret — MUST be different from BOTH
# JWT_SECRET and CSRF_SECRET (three separate secrets, three separate
# purposes). Generate the same way: openssl rand -hex 32
# Railway's Variables tab only — never here, never in chat.
ADMIN_JWT_SECRET=set-this-directly-in-railway-only

PORT=3000
