# Copy this file's structure into Railway's environment variables (Railway
# dashboard -> your service -> Variables tab). Never commit a real .env
# file with actual values — .gitignore already excludes .env and .env.local.

# Razorpay Key ID is safe to expose (it's meant to run in the browser).
# The Key Secret is NOT — it must only ever exist in Railway's environment
# variables, never in this file, never in code, never pasted in chat.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=set-this-directly-in-railway-only

# The webhook secret is configured separately, in the Razorpay Dashboard
# under Settings -> Webhooks, when you set the webhook URL to
# https://your-domain/webhooks/razorpay. Razorpay shows you this secret
# once, at that point — same rule as the Key Secret: Railway only, never
# committed here, never pasted in chat.
RAZORPAY_WEBHOOK_SECRET=set-this-directly-in-railway-only

# Set automatically by Railway once Postgres is added to the project and
# referenced from this service (Variables tab -> add DATABASE_URL -> value
# ${{Postgres.DATABASE_PRIVATE_URL}}). Locally, point this at your own
# Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/akara_dev

# Any long random string — used to sign login session tokens. Generate one
# with: openssl rand -hex 32
# Set this directly in Railway's Variables tab, never commit the real value.
JWT_SECRET=set-this-directly-in-railway-only

# Any long random string, DIFFERENT from JWT_SECRET — used for CSRF
# protection (see server/csrf.js). Generate the same way: openssl rand -hex 32
# Same rule: Railway's Variables tab only, never committed here.
CSRF_SECRET=set-this-directly-in-railway-only

# Admin panel session signing secret — MUST be different from BOTH
# JWT_SECRET and CSRF_SECRET (three separate secrets, three separate
# purposes). Generate the same way: openssl rand -hex 32
# Railway's Variables tab only — never here, never in chat.
ADMIN_JWT_SECRET=set-this-directly-in-railway-only

# Encrypts each admin's 2FA (TOTP) secret at rest, so a leaked database
# dump doesn't hand over everyone's real 2FA secrets directly — MUST be
# different from every other secret above. Generate with:
# openssl rand -hex 32
# Railway's Variables tab only — never here, never in chat. Changing this
# after admins have already set up 2FA breaks their existing setup (their
# stored secret becomes undecryptable) — treat it as a one-time value,
# same as the others.
TOTP_ENCRYPTION_KEY=set-this-directly-in-railway-only

PORT=3000

# Your site's real, canonical URL — used to build absolute links in emails
# (e.g. the password reset link, the "complete your order" reminder) and
# as the fallback base for SEO meta tags. Must be the working www domain,
# not the bare/apex one.
SITE_URL=https://www.akaraonline.co.in

# Optional. Where to send email — set up via Resend (resend.com): create
# an account, verify the sending domain (akaraonline.co.in) there via DNS
# records (SPF/DKIM), then generate an API key. Every email-sending
# function in server/email.js quietly no-ops with a console warning if
# this is missing — orders and checkout keep working either way, email is
# purely additive.
RESEND_API_KEY=set-this-directly-in-railway-only
# Optional. Overrides the default "from" address (order@akaraonline.co.in)
# if you ever want a different sender.
EMAIL_FROM=ĀKĀRA <order@akaraonline.co.in>
# Optional. Where low-stock/sold-out alerts go. Falls back to
# support@akaraonline.co.in if not set.
ALERT_EMAIL=support@akaraonline.co.in

# Optional. WhatsApp order notifications via Gupshup (gupshup.io).
# GUPSHUP_API_KEY comes from the Gupshup dashboard's API Keys section.
# GUPSHUP_SOURCE_NUMBER is the WhatsApp Business number registered there,
# digits only. GUPSHUP_APP_NAME defaults to "AKARAAPP" if not set — must
# match exactly what's configured in Gupshup. Each template ID below is
# independent — set only the ones actually approved by WhatsApp so far;
# whichever aren't set are silently skipped, not an error. See
# server/whatsapp.js for exactly what each message contains.
GUPSHUP_API_KEY=set-this-directly-in-railway-only
GUPSHUP_SOURCE_NUMBER=91XXXXXXXXXX
GUPSHUP_APP_NAME=AKARAAPP
GUPSHUP_TEMPLATE_CONFIRMED=set-this-directly-in-railway-only
GUPSHUP_TEMPLATE_DISPATCHED=set-this-directly-in-railway-only
GUPSHUP_TEMPLATE_DELIVERED=set-this-directly-in-railway-only

# Optional. Real, permanent object storage for product photos/videos via
# Cloudflare R2 (dash.cloudflare.com -> R2 Object Storage -> create a
# bucket -> Manage API Tokens -> create one with Object Read & Write,
# scoped to that bucket). Without these set, uploads fall back to
# Railway's own disk, which does NOT persist across redeploys — a real
# gap fine for local development, but not for real product photos. See
# server/r2.js.
R2_ACCOUNT_ID=set-this-directly-in-railway-only
R2_ACCESS_KEY_ID=set-this-directly-in-railway-only
R2_SECRET_ACCESS_KEY=set-this-directly-in-railway-only
R2_BUCKET_NAME=akara-product-media
# The bucket's own public URL (Cloudflare shows this once the bucket's
# Public Access setting is enabled) — looks like https://pub-xxxx.r2.dev
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Optional. Real courier integration via Shiprocket (shiprocket.in) — used
# to create a real shipment and fetch live tracking status once an order
# is dispatched. Without these set, dispatching an order still works, it
# just skips the real courier booking step. See server/shiprocket.js.
SHIPROCKET_EMAIL=set-this-directly-in-railway-only
SHIPROCKET_PASSWORD=set-this-directly-in-railway-only


# Google Sign-In (customer login/signup). Client ID is required on the
# server AND is exposed to the browser via GET /api/auth/google-config.
# Client secret is optional for the ID-token flow we use; keep it in
# env only if you add other Google APIs later. Never commit real secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@akaraonline.co.in

# Web Push (PWA) — generated for this project; set the same values on Railway
VAPID_PUBLIC_KEY=BJH0vkdrVwPD_jBNrab9IVfg5S-1pAjyQ7IJa3VWkt83TCmRkUBzlAxWnDQ3Cpxi-dNbFdu1IWuDhaE1XovgedI
VAPID_PRIVATE_KEY=3w-t760lH5-foQumTLR5iQchfH2w1Es1nAbv7XABGVQ
VAPID_SUBJECT=mailto:admin@akaraonline.co.in
