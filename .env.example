# Copy this file's structure into Railway's environment variables (Railway
# dashboard -> your service -> Variables tab). Never commit a real .env
# file with actual values — .gitignore already excludes .env and .env.local.

# Razorpay Key ID is safe to expose (it's meant to run in the browser).
# The Key Secret is NOT — it must only ever exist in Railway's environment
# variables, never in this file, never in code, never pasted in chat.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=set-this-directly-in-railway-only

# Set automatically by Railway once Postgres is added to the project and
# referenced from this service (Variables tab -> add DATABASE_URL -> value
# ${{Postgres.DATABASE_PRIVATE_URL}}). Locally, point this at your own
# Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/akara_dev

# Any long random string — used to sign login session tokens. Generate one
# with: openssl rand -hex 32
# Set this directly in Railway's Variables tab, never commit the real value.
JWT_SECRET=set-this-directly-in-railway-only

PORT=3000
